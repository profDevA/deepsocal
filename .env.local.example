# Sanity CMS
# Create a project at https://www.sanity.io/manage and paste the values below
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-22

# Sanity read token (optional — needed for live preview / draft mode)
# Create under API → Tokens in your Sanity project settings
# SANITY_API_READ_TOKEN=

# Existing keys
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
